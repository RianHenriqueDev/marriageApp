# Configurações do Banco de Dados Supabase (PostgreSQL)
# Conexão via PgBouncer (Porta 6543) com pgbouncer=true
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexão direta para Migrações do Prisma (Porta 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Senha de acesso ao Painel de Administração (/admin)
ADMIN_PASSWORD="casamento12122026"

# URL Base da Aplicação (usada para gerar links de convites completos)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
