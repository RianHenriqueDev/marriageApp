datasource db {
  provider  = "postgresql"
  url       = env("marriageapp_DATABASE_URL")
  directUrl = env("marriageapp_POSTGRES_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AttendanceSelection {
  BOTH            // Participará da Cerimônia no Cartório e do Almoço na JP Steakhouse
  ONLY_CEREMONY   // Participará exclusivamente da Cerimônia no Cartório
  ONLY_RESTAURANT // Participará exclusivamente do Almoço na JP Steakhouse
  DECLINED        // Não poderá comparecer a nenhum momento
}

enum RsvpState {
  PENDING
  CONFIRMED
  DECLINED
}

enum GuestCategory {
  BRIDE_FRIEND        // Amigo(a) da Noiva
  GROOM_FRIEND        // Amigo(a) do Noivo
  MUTUAL_FRIEND       // Amigo(a) de Ambos
  BRIDE_ACQUAINTANCE  // Conhecido(a) da Noiva
  GROOM_ACQUAINTANCE  // Conhecido(a) do Noivo
  MUTUAL_ACQUAINTANCE // Conhecido(a) de Ambos
  BRIDE_FAMILY        // Família da Noiva
  GROOM_FAMILY        // Família do Noivo
  MUTUAL_FAMILY       // Família de Ambos
}

model Guest {
  id                 String              @id @default(cuid())
  token              String              @unique // slug limpo e humanizado (ex: tios-paulo-e-lucia-8a2)
  name               String              // Nome formal exibido no convite (ex: "Paulo & Lúcia")
  phone              String?             // WhatsApp formatado
  maxGuests          Int                 @default(1) // Capacidade máxima de convidados cobertos por este convite
  confirmedGuests    Int                 @default(0) // Quantidade real confirmada (total: titular + conjuge + filhos)
  hasSpouse          Boolean             @default(false) // Convidado confirmou presença do cônjuge/parceiro(a)
  childrenCount      Int                 @default(0) // Quantidade de filhos confirmados
  attendance         AttendanceSelection @default(BOTH)
  status             RsvpState           @default(PENDING)
  category           GuestCategory       @default(MUTUAL_FRIEND)
  guestMessage       String?             // Recado especial deixado para o casal
  respondedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([token])
  @@index([status])
  @@index([category])
}

